{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build active file",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-g",
        "-Wall",
        "-Wextra",
        "-Wshadow",
        "${file}",
        "-o",
        "${workspaceFolder}/build/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": { "PATH": "C:/msys64/ucrt64/bin;${env:PATH}" }
      },
      "dependsOn": "C++: make build dir",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "C++: build and run active file",
      "type": "shell",
      "command": "& '${workspaceFolder}/build/${fileBasenameNoExtension}.exe'",
      "options": {
        "cwd": "${fileDirname}",
        "env": { "PATH": "C:/msys64/ucrt64/bin;${env:PATH}" }
      },
      "dependsOn": "C++: build active file",
      "problemMatcher": [],
      "presentation": { "focus": true, "clear": true }
    },
    {
      "label": "C++: make build dir",
      "type": "shell",
      "command": "New-Item -ItemType Directory -Force '${workspaceFolder}/build' | Out-Null",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    }
  ]
}
